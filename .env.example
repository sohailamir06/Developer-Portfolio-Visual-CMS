# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development

# API port (5000 is often taken by WSL/AirPlay on dev machines)
PORT=5050

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/developer_portfolio
# Used only by `npm test` — tests drop this database, never point it at real data
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/developer_portfolio_test

# Public site origin (CORS allow-list, sitemap, canonical URLs). Comma-separate extra origins.
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# Secret used to sign the session JWT (required, min 32 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Media storage: "local" (files saved to server/uploads) or "cloudinary"
MEDIA_PROVIDER=local
MEDIA_MAX_FILE_MB=5
# Required only when MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# Optional: email notification for new contact messages (messages are always saved to MongoDB)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=
